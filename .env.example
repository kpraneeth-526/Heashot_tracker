# Copy this file to .env (same folder) and fill in your values.
# .env is git-ignored; never put the real password in any other file.
#
# Leave everything commented out to use Mailpit (fake inbox) instead.

# Gmail: use a separate demo account and an App Password
# (Google Account > Security > 2-Step Verification > App passwords).
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=yourbooth@gmail.com
#SMTP_PASSWORD=abcd efgh ijkl mnop
